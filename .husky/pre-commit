#!/usr/bin/env bash
# Pre-commit quality gate: Prettier + markdownlint on staged files.
set -e

echo "Running Prettier check..."
STAGED_FMT=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|json|css|html|md|yaml|yml|sh)$' || true)
if [ -n "$STAGED_FMT" ]; then
  echo "$STAGED_FMT" | xargs -r npx prettier --check 2>&1 || {
    echo "❌ Prettier check failed. Run 'npm run fmt:fix' to fix."
    exit 1
  }
fi

echo "Running markdownlint check..."
STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)
if [ -n "$STAGED_MD" ]; then
  echo "$STAGED_MD" | xargs -r npx markdownlint-cli --config .markdownlint.json 2>&1 || {
    echo "❌ Markdown lint failed. Run 'npm run lint:md:fix' to fix."
    exit 1
  }
fi

echo "✅ Pre-commit checks passed."
