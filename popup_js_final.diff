  function toggleSettings() {
    // elements.settingsPanel initially has 'hidden' class
    // toggle returns true if class added, false if removed
    const isHidden = elements.settingsPanel.classList.toggle("hidden");
    const isNowVisible = !isHidden;

    elements.manualSection.classList.toggle("hidden", isNowVisible);
    elements.settingsLink.textContent = isNowVisible ? "Back" : "Settings";
    elements.settingsLink.setAttribute(
      "aria-expanded",
      isNowVisible.toString(),
    );
    elements.settingsLink.setAttribute("aria-pressed", isNowVisible.toString());

    if (isNowVisible) {
      // Focus API endpoint input when opening
      elements.apiEndpoint.focus();
    } else {
      // Return focus to settings link when closing
      elements.settingsLink.focus();
    }
  }
