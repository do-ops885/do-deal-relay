# Prettier Ignore Patterns
# Files and directories that Prettier should not format

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment files
.env*
!.env.example

# Logs
*.log

# Generated files
*.generated.ts
*.generated.js

# Markdown (let markdownlint handle these)
*.md

# JSON files (often auto-generated)
state.json
*.lock

# Minified files
*.min.js
*.min.css

# Vendor directories
vendor/
third_party/

# Test outputs
coverage/

.prettierignore

# YAML lint config (Prettier doesn't recognize .yamllint extension)
.yamllint

# VERSION file (no extension — Prettier can't infer parser)
VERSION

# Coordination state & handoff log (JSONL format — Prettier doesn't support)
agents-docs/coordination/handoff-log.jsonl

# Auto-generated skill evaluation JSON results
.agents/skills/*/evals/test_results.json

# Skill scaffolding templates are copied into new projects, not formatted here
.agents/skills/**/templates/**

# Claude skill symlinks (broken symlinks cause parse errors)
.claude/
