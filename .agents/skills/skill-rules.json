{
  "version": 2,
  "description": "Trigger rules for skill activation. Every entry must name a directory in .agents/skills/; validated by scripts/skill-eval-check.sh.",
  "rules": [
    {
      "skill": "do-deal-relay",
      "triggers": {
        "keywords": [
          "deal",
          "deals",
          "referral",
          "referral code",
          "mcp",
          "deal discovery"
        ],
        "files": ["worker/routes/referrals*.ts", "worker/routes/mcp/**/*"]
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "validation-gates",
      "triggers": {
        "keywords": ["validation", "gate", "validation gate", "pipeline"],
        "files": ["worker/validation/**/*"]
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "pre-commit",
      "triggers": {
        "keywords": ["commit", "hook", "pre-commit", "husky", "commitlint"],
        "files": [".pre-commit-config.yaml", ".husky/**/*"]
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "guard-rails",
      "triggers": {
        "keywords": [
          "guard rail",
          "guard-rail",
          "bypass",
          "no-verify",
          "secret scan"
        ],
        "files": ["worker/lib/guard-rails.ts"]
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "shell-script-quality",
      "triggers": {
        "keywords": ["shell", "bash", "script", "shellcheck", "bats"],
        "files": ["**/*.sh", "scripts/**/*"]
      },
      "priority": "high",
      "autoActivate": true
    },
    {
      "skill": "task-decomposition",
      "triggers": {
