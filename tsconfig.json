{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["@cloudflare/workers-types", "@playwright/test", "vitest", "node"]
  },
  "include": ["worker/**/*.ts", "bot/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "bot/discord",
    "bot/telegram",
    "scripts",
    "tests/browser"
  ]
}
