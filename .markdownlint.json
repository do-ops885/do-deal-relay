{
  "default": true,
  "line-length": {
    "line_length": 120,
    "code_blocks": false,
    "tables": false
  },
  "no-inline-html": false,
  "no-duplicate-heading": {
    "siblings_only": true
  },
  "first-line-h1": false,
  "no-emphasis-as-heading": false,
  "single-trailing-newline": true,
  "no-hard-tabs": true,
  "no-trailing-spaces": true,
  "ul-style": {
    "style": "dash"
  },
  "list-marker-space": {
    "ul_single": 1,
    "ol_single": 1,
    "ul_multi": 1,
    "ol_multi": 1
  }
}
